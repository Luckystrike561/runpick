#!/usr/bin/env bash
# runpick — pick a devbox script with fzf and run it.
#
# Copyright 2026 Luckystrike561
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail

VERSION=1.0.0

# Resolved eagerly: fzf runs the preview as a subprocess, which needs a path
# that does not depend on the caller's working directory.
SELF=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")

die() {
  printf 'runpick: %s\n' "$1" >&2
  exit 1
}

usage() {
  cat <<'EOF'
runpick — pick a devbox script with fzf and run it

usage (inside `devbox run` or `devbox shell`):
  runpick [--print]
  runpick --list
  runpick --preview <key>
  runpick --version | --help

options:
  --list          print every candidate script name and exit
  --print         print the command for the chosen script instead of running it
  --preview KEY   print one script's command (used by fzf)
EOF
}

# devbox.json is JSONC: devbox accepts // and /* */ comments, jq does not.
# Stripping them needs to respect string contents, or the `https://` in
# "$schema" becomes a comment and the file stops parsing.
strip_comments() {
  awk '
    BEGIN { ins = 0; blk = 0 }
    {
      out = ""
      n = length($0)
      for (i = 1; i <= n; i++) {
        c = substr($0, i, 1)
        nxt = substr($0, i + 1, 1)
        if (blk) {
          if (c == "*" && nxt == "/") { blk = 0; i++ }
          continue
        }
        if (ins) {
          out = out c
          if (c == "\\") { out = out nxt; i++; continue }
          if (c == "\"") ins = 0
          continue
        }
        if (c == "\"") { ins = 1; out = out c; continue }
        if (c == "/" && nxt == "/") break
        if (c == "/" && nxt == "*") { blk = 1; i++; continue }
        out = out c
      }
      print out
    }
  ' "$1"
}

# SCRIPTS holds .shell.scripts as {key: command}, with array scripts joined
# into one multi-line string.
load_scripts() {
  local src=$ROOT/devbox.json
  [[ -f $src ]] || die "no devbox.json in $ROOT"
  SCRIPTS=$(strip_comments "$src" | jq -c '
    .shell.scripts // {}
    | map_values(if type == "array" then join("\n") else . end)
  ' 2>/dev/null) || die "$src is not valid JSON, even with comments stripped"
}

preview() {
  jq -r --arg k "$1" '.[$k] // empty' <<<"$SCRIPTS"
}

# The picker never lists itself. Matched case-insensitively so an alias
# written as `bash "$RUNPICK_BIN"` counts.
candidates() {
  jq -r --arg me "$(basename "$SELF")" '
    to_entries[]
    | select(.value | ascii_downcase | contains($me) | not)
    | .key
  ' <<<"$SCRIPTS"
}

main() {
  local mode=run key="" listing choice

  while (($#)); do
    case $1 in
      --help | -h) usage; return 0 ;;
      --version | -V) printf 'runpick %s\n' "$VERSION"; return 0 ;;
      --list) mode=list ;;
      --print) mode=print ;;
      --preview) mode=preview; key=${2-}; shift ;;
      *) die "unknown argument: $1" ;;
    esac
    shift
  done

  # devbox resolves the project from any subdirectory and exports its root to
  # every `devbox run` and `devbox shell`.
  ROOT=${DEVBOX_PROJECT_ROOT:-}
  [[ -n $ROOT ]] || die "DEVBOX_PROJECT_ROOT is unset; run via 'devbox run pick'"
  command -v jq >/dev/null || die "jq is required"
  load_scripts

  case $mode in
    preview)
      [[ -n $key ]] || die "--preview needs a script name"
      preview "$key"
      return 0
      ;;
    list) candidates; return 0 ;;
  esac

  listing=$(candidates)
  [[ -n $listing ]] || die "no runnable scripts in $ROOT/devbox.json"
  command -v fzf >/dev/null || die "fzf is required for the picker"

  choice=$(
    fzf --prompt="devbox run " --height=40% --reverse --no-multi \
      --preview="bash $(printf '%q' "$SELF") --preview {}" \
      --preview-window='down,4,wrap' <<<"$listing"
  ) || return 0
  [[ -n $choice ]] || return 0

  if [[ $mode == print ]]; then
    printf 'devbox run %q\n' "$choice"
    return 0
  fi

  cd "$ROOT"
  exec devbox run "$choice"
}

main "$@"
